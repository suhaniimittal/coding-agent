
AETHERION_AGENT_TASK_QUEUE=aetherion-workflows-464f9cb5-62f9-472f-bef9-fae7ab28f536
AETHERION_TOOL_TASK_QUEUE=aetherion-activities-464f9cb5-62f9-472f-bef9-fae7ab28f536

# --- GitHub (download repos at the TDD's commit, push a branch, open PRs) ---
# Needs Contents + Pull requests read/write on each repo.
GITHUB_TOKEN=
# Leave blank for github.com. For GitHub Enterprise Server set the API address,
# e.g. https://github.asurint.com/api/v3 (the token must be valid on that host).
# Alternatively store repos as full URLs and this is derived from the host.
GITHUB_API_URL=

# --- The coding model ---
# With no gateway key (a laptop), OpenAI directly.
OPENAI_API_KEY=
#
# Aetherion AI Gateway: used whenever a key is set (the platform sets one,
# as AGENTS_GATEWAY_KEY, BIFROST_VIRTUAL_KEY or AI_GATEWAY_KEY).
AI_GATEWAY_URL=
AGENTS_GATEWAY_KEY=
# Blank: the strongest Claude the gateway offers (claude-opus-5-5, then older).
CODING_MODEL=

STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

STORAGE_ENDPOINT=
 
STORAGE_SECURE=
 
STORAGE_AGENTS_BUCKET=
TENANT_ID=

# --- The coding run (blank = the default shown) ---
# Where each run's downloaded code lives while it works (default: the system temp folder/coding-runs).
CODING_WORK_DIR=
# Minutes the run's folder is kept after its pull request is opened (5).
CODING_KEEP_MINUTES=
# Extra rounds in which the model may ask to see more code before the change (1).
CODING_LOOK_ROUNDS=
# Rounds in which the model fixes what the checks found (1).
CODING_FIX_ROUNDS=
# false: skip the review call that checks the diff against the ticket (one model call less). Default: on.
CODING_REVIEW=
# true: every pull request is opened as a draft (true). false: a draft only when something is open.
CODING_DRAFT_PR=
# true: the model may add and change test files. Blank (false): source code only; Jenkins runs the existing tests.
CODING_WRITE_TESTS=
