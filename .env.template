# --- Neo4j (the SAME graph planning_agent writes to — a deliberate shared-
# infrastructure dependency, used only to resolve a TDD's service name to
# its real repo; a service planning_agent has never ingested can't be
# resolved this way, by design.) ---
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- GitHub (clone target repos, open PRs) ---
GITHUB_TOKEN=
# Leave blank for github.com. For GitHub Enterprise Server set the API address,
# e.g. https://github.asurint.com/api/v3 (the token must be valid on that host).
# Alternatively store repos as full URLs and this is derived from the host.
GITHUB_API_URL=

# --- Embeddings/LLM extraction call ---
# Default: OpenAI directly. Fill this in for local dev / running as-is.
OPENAI_API_KEY=
#
# Aetherion AI Gateway — optional override. Leave both blank to use OpenAI
# above. Only fill these in once published on the platform (if the platform
# injects/requires them) — if both are set, the gateway takes priority.
AI_GATEWAY_URL=
AGENTS_GATEWAY_KEY=

STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

STORAGE_ENDPOINT=
 
STORAGE_SECURE=
 
STORAGE_AGENTS_BUCKET=
TENANT_ID=

USE_LOCAL_REPO=
LOCAL_REPO_PATH=